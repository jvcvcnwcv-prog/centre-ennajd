# Centre Ennajd ERP - Environment Configuration
# Copy this file to .env and fill in your Supabase credentials

# Supabase Project URL (found in your Supabase project settings)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (found in your Supabase project settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Do NOT commit your actual .env file to version control
# The .env file is in .gitignore by default